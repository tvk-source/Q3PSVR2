+/* PS5VR_GUN_STEREO_AB_V1 */
+/* Stock VM syscalls only: no trap_Cvar_VariableValue symbol. */
+static float PS5VR_GunAB_Cvar(const char *key, float defaultValue) {
+    char raw[64];
+    trap_Cvar_VariableStringBuffer(key, raw, sizeof(raw));
+    if (!raw[0]) return defaultValue;
+    return (float)atof(raw);
+}
+
+static float PS5VR_GunAB_Clamp(float x, float low, float high) {
+    if (x < low) return low;
+    if (x > high) return high;
+    return x;
+}
+
+/* PS5VR_PCVR_VISUAL_V1 */
+/* PCVR profiles: RippeR37/q3vr code/vr/vr_cvars.c (GPLv2).
+ * format: scale, right, up, forward, pitch, yaw, roll. */
+static void PS5VR_PCProfile(int weapon, float *scale, float *right,
+                             float *up, float *forward, float *pitch,
+                             float *yaw, float *roll) {
+    *scale = 1.0f; *right = 0.0f; *up = 0.0f;
+    *forward = 0.0f; *pitch = 0.0f; *yaw = 0.0f; *roll = 0.0f;
+    switch (weapon) {
+    case 1: *scale=1.0f; *right=-4.0f; *up=7.0f; *forward=-10.0f; *pitch=-20.0f; *yaw=-15.0f; break;
+    case 2: *scale=.80f; *right=-3.0f; *up=5.5f; break;
+    case 3: *scale=.80f; *right=-3.3f; *up=8.0f; *forward=3.7f; break;
+    case 4: *scale=.75f; *right=-5.4f; *up=6.5f; *forward=-4.0f; break;
+    case 5: *scale=.80f; *right=-5.2f; *up=6.0f; *forward=7.5f; break;
+    case 6: *scale=.80f; *right=-3.3f; *up=6.0f; *forward=7.0f; break;
+    case 7: *scale=.80f; *right=-5.5f; *up=6.0f; break;
+    case 8: *scale=.80f; *right=-4.5f; *up=6.0f; *forward=1.5f; break;
+    case 9: *scale=.80f; *right=-5.5f; *up=6.0f; break;
+    case 11: case 12: case 13: *scale=.80f; *right=-5.5f; *up=6.0f; break;
+    default: break;
+    }
+}
+
+static float PS5VR_PCProfileScale(int weapon) {
+    float s, r, u, f, p, y, roll;
+    if (PS5VR_GunAB_Cvar("ps5vr_pcvrGun", 0.0f) < 0.5f) return 1.0f;
+    PS5VR_PCProfile(weapon, &s, &r, &u, &f, &p, &y, &roll);
+    return s;
+}
