+/* PS5VR_VM_AIM_V1_BEGIN */
+#ifndef RF_CROSSHAIR
+#define RF_CROSSHAIR 0x0010
+#endif
+
+/*
+ * Experimental VR reticle: use cgame collision against static BSP AND
+ * snapshot entities, unlike the PS5 renderer's static-BSP-only trace.
+ * This module still uses the existing Quake gameplay aim.  It deliberately
+ * does NOT modify bullet direction or VR camera transforms.
+ *
+ * Source is GPLv2+ derived from id Software Quake III Arena cgame.
+ */
+/* Stock Quake III cgame.qvm has no trap_Cvar_VariableValue syscall. */
+static float PS5VR_VM_CvarValue(const char *name) {
+    char value[64];
+    value[0] = '\0';
+    trap_Cvar_VariableStringBuffer(name, value, sizeof(value));
+    return (float)atof(value);
+}
+
+static void PS5VR_DrawVMReticle(void) {
+    static qhandle_t ps5vrReticleShader = 0;
+    static qboolean ps5vrAnnounced = qfalse;
+    refEntity_t ent;
+    trace_t trace;
+    vec3_t muzzle, forward, endpoint, target, delta;
+    float range, angularSize, separation, gap, distance;
+    int k;
+
+    if (PS5VR_VM_CvarValue("ps5vr_vmReticle") < 0.5f &&
+        PS5VR_VM_CvarValue("ps5vr_laserSight") < 0.5f) return;
+    if (!cg.snap || cg.levelShot || cg.renderingThirdPerson || cg.showScores) return;
+    if (cg.snap->ps.pm_type == PM_INTERMISSION) return;
+    if (cg.snap->ps.persistant[PERS_TEAM] == TEAM_SPECTATOR) return;
+    if (cg.snap->ps.stats[STAT_HEALTH] <= 0) return;
+
+    if (!ps5vrAnnounced) {
+        CG_Printf("^2PS5VR VM aim v1: gameplay trace enabled (QVM)\n");
+        ps5vrAnnounced = qtrue;
+    }
+    if (!ps5vrReticleShader) {
+        ps5vrReticleShader = trap_R_RegisterShader("ps5vr/reticle");
+        if (!ps5vrReticleShader) {
+            CG_Printf("^1PS5VR QVM reticle shader missing: install zzzz-ps5vr-reticle.pk3\n");
+            return;
+        }
+    }
+
+    /* Mirrors the server's CalcMuzzlePointOrigin convention: prediction
+     * origin + viewheight + 14 units forward using player viewangles.
+     * The exact shot point can still differ for specific weapons/frames. */
+    AngleVectors(cg.predictedPlayerState.viewangles, forward, NULL, NULL);
+    VectorCopy(cg.predictedPlayerState.origin, muzzle);
+    muzzle[2] += cg.predictedPlayerState.viewheight;
+    VectorMA(muzzle, 14.0f, forward, muzzle);
+
+    range = PS5VR_VM_CvarValue("ps5vr_vmReticleRange");
+    if (range < 128.0f) range = 4096.0f;
+    if (range > 16384.0f) range = 16384.0f;
+    VectorMA(muzzle, range, forward, endpoint);
+    CG_Trace(&trace, muzzle, vec3_origin, vec3_origin, endpoint,
+             cg.predictedPlayerState.clientNum, MASK_SHOT);
+    if (trace.startsolid || trace.allsolid) return;
+    VectorCopy(trace.endpos, target);
+
+    /* Offset a hit in the collision plane normal to avoid Z fighting.
+     * We do not use depth hack unless the user explicitly requests it. */
+    if (trace.fraction < 1.0f) {
+        gap = PS5VR_VM_CvarValue("ps5vr_vmReticleOffset");
+        if (gap < 0.0f) gap = 0.0f;
+        if (gap > 6.0f) gap = 6.0f;
+        if (gap < 0.01f) gap = 1.0f;
+        VectorMA(target, gap, trace.plane.normal, target);
+    }
+
+    /* Q3PSVR2_LASER_V1: uses the same gameplay hit as our QVM reticle.
+     * RT_RAIL_CORE exists in stock Quake III: draws a 3D beam between
+     * origin and oldorigin; the rail shader may affect thickness/colour.
+     * One beam per scene build. NO extra collision trace. */
+    if (PS5VR_VM_CvarValue("ps5vr_laserSight") > 0.5f) {
+        refEntity_t beam;
+        if (cgs.media.railCoreShader) {
+            memset(&beam, 0, sizeof(beam));
+            beam.reType = RT_RAIL_CORE;
+            beam.customShader = cgs.media.railCoreShader;
+            VectorCopy(muzzle, beam.origin);
+            if (trace.fraction < 1.0f) {
+                VectorMA(trace.endpos, -1.5f, forward, beam.oldorigin);
+            } else {
+                VectorCopy(trace.endpos, beam.oldorigin);
+            }
+            beam.shaderRGBA[0] = 255;
+            beam.shaderRGBA[1] = 40;
+            beam.shaderRGBA[2] = 30;
+            beam.shaderRGBA[3] = 120;
+            trap_R_AddRefEntityToScene(&beam);
+        }
+    }
+
+    if (PS5VR_VM_CvarValue("ps5vr_vmReticle") < 0.5f) return;
+    VectorSubtract(target, cg.refdef.vieworg, delta);
+    distance = VectorLength(delta);
+    if (distance < 4.0f) return; /* behind/inside stereo near plane */
+    angularSize = PS5VR_VM_CvarValue("ps5vr_vmReticleAngle");
+    if (angularSize < 0.2f) angularSize = 2.5f;
+    if (angularSize > 8.0f) angularSize = 8.0f;
+    /* tan(theta/2) ~= theta/2 to better than 0.2% for <=8 degrees;
+     * avoids relying on math-library functions in the QVM toolchain. */
+    separation = distance * angularSize * 0.00872664626f;
+    if (separation < 0.65f) separation = 0.65f;
+    if (separation > 225.0f) separation = 225.0f;
+
+    memset(&ent, 0, sizeof(ent));
+    ent.reType = RT_SPRITE;
+    ent.radius = separation;
+    ent.customShader = ps5vrReticleShader;
+    if (PS5VR_VM_CvarValue("ps5vr_vmReticleDepthHack") > 0.5f) {
+        ent.renderfx = RF_DEPTHHACK | RF_CROSSHAIR;
+    }
+    for (k = 0; k < 3; ++k) ent.origin[k] = target[k];
+    ent.shaderRGBA[0] = 255;
+    ent.shaderRGBA[1] = 255;
+    ent.shaderRGBA[2] = 255;
+    ent.shaderRGBA[3] = 255;
+    trap_R_AddRefEntityToScene(&ent);
+}
+/* PS5VR_VM_AIM_V1_END */
