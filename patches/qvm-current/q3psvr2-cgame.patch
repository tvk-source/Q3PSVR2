+/* PS5VR_PCVR_VISUAL_V1 */
+/* minimalist center-bottom QVM HUD.
+ * Drawn in the existing PS5VR UI path, never touches menus or bot chat.
+ * UI cvars are read from supported Quake III QVM syscall. */
+static void PS5VR_PCHud(void) {
+    playerState_t *ps;
+    int gun, ammo, hp, armor, cw, ch, icon;
+    float scale, y, gap;
+    vec4_t ammoColor = {1.0f, 0.72f, 0.18f, 1.0f};
+    vec4_t hpColor = {1.0f, 0.72f, 0.18f, 1.0f};
+    vec4_t armorColor = {0.48f, 0.85f, 1.0f, 1.0f};
+    char raw[64];
+    if (!cg.snap) return;
+    ps = &cg.snap->ps;
+    gun = cg.predictedPlayerState.weapon;
+    ammo = (gun > 0 && gun < MAX_WEAPONS) ? ps->ammo[gun] : -1;
+    hp = ps->stats[STAT_HEALTH];
+    armor = ps->stats[STAT_ARMOR];
+    trap_Cvar_VariableStringBuffer("ps5vr_pcvrHudScale", raw, sizeof(raw));
+    scale = raw[0] ? (float)atof(raw) : 0.75f;
+    if (scale < 0.45f) scale = 0.45f;
+    if (scale > 1.30f) scale = 1.30f;
+    trap_Cvar_VariableStringBuffer("ps5vr_pcvrHudY", raw, sizeof(raw));
+    y = raw[0] ? (float)atof(raw) : 423.0f;
+    if (y < 325.0f) y = 325.0f;
+    if (y > 462.0f) y = 462.0f;
+    cw = (int)(17.0f * scale);
+    ch = (int)(24.0f * scale);
+    icon = (int)(26.0f * scale);
+    gap = 98.0f * scale;
+    if (hp < 26) {
+        hpColor[0] = 1.0f; hpColor[1] = .25f; hpColor[2] = .25f;
+    }
+    if (ammo >= 0) {
+        if (gun < MAX_WEAPONS && cg_weapons[gun].ammoIcon) {
+            CG_DrawPic(320 - gap - icon - 3, y-2, icon, icon, cg_weapons[gun].ammoIcon);
+        }
+        CG_DrawStringExt((int)(320 - gap), (int)y, va("%i", ammo), ammoColor,
+                         qtrue, qfalse, cw, ch, 3);
+    }
+    CG_DrawStringExt((int)(320 - (hp < 100 ? 12*scale : 18*scale)), (int)y,
+                     va("%i", hp), hpColor, qtrue, qfalse, cw, ch, 3);
+    if (armor > 0) {
+        CG_DrawStringExt((int)(320 + gap), (int)y,
+                         va("%i", armor), armorColor, qtrue, qfalse, cw, ch, 3);
+        if (cgs.media.armorIcon) {
+            CG_DrawPic(320 + gap + 3*cw + 3, y-2, icon, icon, cgs.media.armorIcon);
+        }
+    }
+}
