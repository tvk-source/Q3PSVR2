 */
+/* PS5VR_CROSSHAIR_STAGE1_BEGIN */
+#ifdef PS5_Q3VR
+/*
+ * Experimental renderer-side reticle, not a game-logic collision raycast.
+ * Render one *world-space* sprite per stereo scene. Both eyes receive the
+ * same Quake-world target and their individual head/eye projections render it.
+ * The QVM's old flat crosshair should be disabled (cg_drawCrosshair=0).
+ *
+ * Future stage: supply a hit point from cgame's weapon trace rather than a
+ * fixed-distance point. Avoid injecting in RDF_NOWORLDMODEL HUD/score views.
+ */
+static void PS5Q3VR_AddWorldReticle(const refdef_t *fd) {
+    static cvar_t *enable, *distance, *angularSize;
+    static cvar_t *traceEnabled;
+    static qhandle_t shader;
+    static qboolean shaderChecked = qfalse;
+    refEntity_t ent;
+    float metres, degrees, quakeDistance, radius;
+    vec3_t traceOrigin, traceDirection;
+    int k;
+
+    if (!PS5Q3VR_IsActive() || (fd->rdflags & RDF_NOWORLDMODEL)) {
+        return;
+    }
+    if (!enable) {
+        enable = ri.Cvar_Get("ps5vr_crosshair", "1", CVAR_ARCHIVE);
+        distance = ri.Cvar_Get("ps5vr_crosshairDistance", "4.0", CVAR_ARCHIVE);
+        angularSize = ri.Cvar_Get("ps5vr_crosshairAngle", "0.75", CVAR_ARCHIVE);
+        traceEnabled = ri.Cvar_Get("ps5vr_crosshairTrace", "0", CVAR_ARCHIVE);
+    }
+    if (!enable->integer) return;
+
+    if (!shaderChecked) {
+        shaderChecked = qtrue;
+        shader = RE_RegisterShaderNoMip("ps5vr/reticle");
+        if (!shader) {
+            ri.Printf(PRINT_WARNING,
+                "ps5vr: gfx/2d/crosshaira missing; VR reticle disabled\n");
+        }
+    }
+    if (!shader) return;
+
+    metres = distance->value;
+    if (metres < 0.75f) metres = 0.75f;
+    if (metres > 50.0f) metres = 50.0f;
+    degrees = angularSize->value;
+    if (degrees < 0.1f) degrees = 0.1f;
+    if (degrees > 3.0f) degrees = 3.0f;
+
+    /* Match ps5_q3vr_engine.c's 32 Quake units/metre scale. */
+    quakeDistance = metres * 32.0f;
+    radius = quakeDistance * tanf(degrees * 0.008726646259971648f);
+
+    VectorCopy(fd->vieworg, traceOrigin);
+    VectorCopy(fd->viewaxis[0], traceDirection);
+    Com_Memset(&ent, 0, sizeof(ent));
+    ent.reType = RT_SPRITE;
+    ent.customShader = shader;
+    ent.renderfx = RF_NOSHADOW;
+    ent.radius = radius;
+    ent.shader.u32 = 0xFFFFFFFFu;
+    for (k = 0; k < 3; ++k) {
+        /* fd->viewaxis[0] = player's gameplay aim direction, NOT the
+         * individual tracked eye axis: one shared 3D target, two views. */
+        ent.origin[k] = fd->vieworg[k] + quakeDistance * fd->viewaxis[0][k];
+    }
+    /* PS5VR_AB_20261021_TRACE_BEGIN */
+    /* Test-only static BSP collision.  This is NOT a cgame/QVM weapon trace:
+     * it knows about level brushes, not live players or weapon spread. */
+    if (traceEnabled && traceEnabled->integer && tr.world) {
+        trace_t hit;
+        vec3_t end;
+        const float rayLen = 3200.0f; /* 100 m at the existing 32 units/m */
+        float d, gap;
+        VectorMA(traceOrigin, rayLen, traceDirection, end);
+        CM_BoxTrace(&hit, traceOrigin, end, vec3_origin, vec3_origin,
+                    0, CONTENTS_SOLID, qfalse);
+        if (!hit.startsolid && !hit.allsolid && hit.fraction < 1.0f) {
+            d = rayLen * hit.fraction;
+            /* Keep the sprite in front of the hit plane, not inside it. */
+            gap = 1.0f + d * tanf(degrees * 0.008726646259971648f);
+            /* Stereo near plane in GetView is ~4 Quake units.
+             * If the wall is INSIDE that plane, normal 3D depth testing
+             * cannot display a sprite between eye and wall. */
+            if (d > gap + 4.5f) {
+                d -= gap;
+                for (k = 0; k < 3; ++k)
+                    ent.origin[k] = traceOrigin[k] + d * traceDirection[k];
+                ent.radius = d * tanf(degrees * 0.008726646259971648f);
+            }
+        }
+    }
+    /* PS5VR_AB_20261021_TRACE_END */
+    RE_AddRefEntityToScene(&ent, qfalse);
+}
+#endif /* PS5_Q3VR */
